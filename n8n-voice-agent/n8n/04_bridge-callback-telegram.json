        340,
        400
      ],
      "credentials": {
        "openAiApi": {
          "id": "openai-key",
          "name": "OpenAI API"
        }
      }
    },
    {
      "parameters": {
        "operation": "sendAudio",
        "chatId": "={{ $('Callback prüfen').first().json.chatId }}",
        "binaryData": true,
        "binaryPropertyName": "data",
        "additionalFields": {
          "fileName": "antwort.mp3"
        }
      },
      "id": "telegram-sprachantwort",
