    {
      "parameters": {
        "jsCode": "const p = $input.first().json;\nconst meta = p.meta || {};\n\nconst zeilen = [];\nzeilen.push((p.ok ? '✅' : '⚠️') + ' *' + (p.projekt || 'Auftrag') + '*');\nzeilen.push('');\nzeilen.push(p.ergebnis || p.fehler || 'Keine Antwort erhalten.');\n\nif (Array.isArray(p.schritte) && p.schritte.length) {\n  zeilen.push('');\n  zeilen.push('_Schritte:_ ' + p.schritte.slice(-6).join(' · '));\n}\nif (p.git) {\n  const offen = (p.git.offene_aenderungen || []).length;\n  zeilen.push('_Git:_ ' + (p.git.branch || '?') + ' — ' + (p.git.letzter_commit || 'kein Commit')\n    + (offen ? ' · ' + offen + ' offene Änderung(en)' : ''));\n}\nconst fuss = [];\nif (p.kosten_usd != null) fuss.push(Number(p.kosten_usd).toFixed(2) + ' $');\nif (p.dauer_ms != null) fuss.push(Math.round(p.dauer_ms / 1000) + ' s');\nif (p.turns != null) fuss.push(p.turns + ' Turns');\nif (fuss.length) zeilen.push('_' + fuss.join(' · ') + '_');\n\n// Für die Sprachausgabe: nur der eigentliche Antworttext, ohne Deko.\nconst sprechtext = (p.ergebnis || p.fehler || 'Der Auftrag ist beendet.')\n  .replace(/[*_`#]/g, '')\n  .slice(0, 1200);\n\nreturn [{\n  json: {\n    text: zeilen.join('\\n'),\n    sprechtext,\n    kanal: meta.kanal,\n    status_ts: meta.status_ts,\n    thread_ts: meta.thread_ts,\n    sprachausgabe: Boolean(p.konfig?.sprachausgabe) && p.ok,\n    ttsModell: p.konfig?.ttsModell,\n    ttsStimme: p.konfig?.ttsStimme,\n  },\n}];"
      },
