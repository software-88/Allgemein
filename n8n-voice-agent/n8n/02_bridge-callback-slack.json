      "id": "bridge-webhook",
      "name": "Bridge Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -320,
        400
      ],
      "webhookId": "claude-callback"
    },
    {
      "parameters": {
        "jsCode": "// ============================================================\n//  ⚙️  KONFIGURATION\n// ============================================================\nconst KONFIG = {\n  // Sprachausgabe der Antwort (optional). Braucht die zusätzlichen,\n  // standardmäßig deaktivierten Nodes am Ende dieses Workflows.\n  sprachausgabe: false,\n  ttsModell: 'gpt-4o-mini-tts',\n  ttsStimme: 'alloy',\n};\n// ============================================================\n\nconst eingang = $input.first();\nif (!eingang.binary || !eingang.binary.data) {\n  throw new Error('Kein Rohkörper. Im Webhook-Node die Option \"Raw Body\" aktivieren.');\n}\nconst roh = Buffer.from(eingang.binary.data.data, 'base64').toString('utf8');\n\n// --- Signatur der Bridge prüfen (gleicher Token wie BRIDGE_TOKEN) ----------\nasync function hmacHex(secret, daten) {\n  try {\n    return require('crypto').createHmac('sha256', secret).update(daten).digest('hex');\n  } catch (e) { /* WebCrypto-Weg */ }\n  const enc = new TextEncoder();\n  const key = await crypto.subtle.importKey(\n    'raw', enc.encode(secret), { name: 'HMAC', hash: 'SHA-256' }, false, ['sign']);\n  const mac = await crypto.subtle.sign('HMAC', key, enc.encode(daten));\n  return Array.from(new Uint8Array(mac)).map(b => b.toString(16).padStart(2, '0')).join('');\n}\n\nconst token = $env.BRIDGE_TOKEN || '';\nconst signatur = (eingang.json.headers || {})['x-bridge-signature'];\nif (token && signatur) {\n  let hex = null;\n  try { hex = await hmacHex(token, roh); } catch (e) { /* s. docs/SICHERHEIT.md */ }\n  if (hex !== null && `sha256=${hex}` !== signatur) {\n    throw new Error('Callback-Signatur ungültig — abgewiesen.');\n  }\n}\n\nconst p = JSON.parse(roh);\nreturn [{ json: { ...p, konfig: KONFIG } }];"
      },
