# Kopieren nach .env und ausfuellen. Diese Datei enthaelt Geheimnisse —
# sie gehoert NICHT ins Git-Repository (.gitignore deckt das ab).

# ---------------------------------------------------------------- Ablage
# Wurzelverzeichnis auf der NAS. Darunter entstehen:
#   n8n/  claude/workspace/  claude/config/  claude/jobs/  claude/home/
DATA_ROOT=/volume1/docker

# Besitzer der Dateien im Share. Auf der NAS ermitteln mit:  id <benutzer>
# (typisch: PUID 1026, PGID 100 fuer "users")
PUID=1026
PGID=100

TZ=Europe/Berlin

# ------------------------------------------------------------------ n8n
# Oeffentlich erreichbarer Name (Slack muss dorthin senden koennen)
N8N_HOST=n8n.meine-domain.de
N8N_PROTOCOL=https
N8N_PUBLIC_URL=https://n8n.meine-domain.de/
N8N_PORT=5678

# Einmalig erzeugen, danach nie aendern:  openssl rand -hex 32
N8N_ENCRYPTION_KEY=

# --------------------------------------------------------------- Bridge
# Gemeinsames Geheimnis zwischen n8n und Bridge (mind. 24 Zeichen):
#   openssl rand -hex 32
BRIDGE_TOKEN=

# Anmeldung von Claude Code — GENAU EINE der beiden Zeilen setzen.
#  a) Abrechnung ueber das Claude-Abo (empfohlen):
#     auf einem Rechner mit Claude Code  `claude setup-token`  ausfuehren
CLAUDE_CODE_OAUTH_TOKEN=
#  b) Abrechnung ueber die API (Schluessel aus der Claude Console):
ANTHROPIC_API_KEY=

# Wie viele Auftraege gleichzeitig auf der NAS laufen duerfen
MAX_CONCURRENT_JOBS=2
# Reissleine pro Auftrag (Sekunden)
JOB_TIMEOUT_SECONDS=1800
# Abstand der Zwischenmeldungen nach Slack (Sekunden)
PROGRESS_INTERVAL_SECONDS=25

# Nur setzen (=1), wenn ein Projekt in projects.yaml wirklich
# permission_mode: bypassPermissions bekommen soll. Im Zweifel leer lassen.
BRIDGE_ALLOW_BYPASS=

# Autor der Commits, die der Agent anlegt
GIT_AUTHOR_NAME=Claude Sprachagent
GIT_AUTHOR_EMAIL=agent@localhost

# ---------------------------------------------------------------- Slack
# Aus der Slack-App unter "Basic Information" -> "Signing Secret"
SLACK_SIGNING_SECRET=

# ------------------------------------------------------ optional: lokal
# Modell fuer den Container "speaches" (Profil lokal-stt)
WHISPER_MODELL=Systran/faster-whisper-small

# --------------------------------------------- optional: Cloudflare-Tunnel
CLOUDFLARE_TUNNEL_TOKEN=
